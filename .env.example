# ============================================================
# CyberGuard AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# Flask secret key - CHANGE THIS to a long random string
SECRET_KEY=cyberguard-ai-secret-key-change-in-production

# MySQL / XAMPP configuration
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=cyber_aggression_copy
MYSQL_PORT=3306

# ML detection threshold (0.0 - 1.0)
# Messages with aggression probability >= this value are blocked
AGGRESSION_THRESHOLD=0.65

# Session expiration in hours
SESSION_EXPIRY_HOURS=24
